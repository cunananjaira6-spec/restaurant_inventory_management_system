{{> head}}
<body class="app-page">
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/dashboard"><span class="brand-mark">P</span><span><strong>mise.</strong><small>STOCKROOM</small></span></a>
      <div class="nav-label">WORKSPACE</div>
      <nav class="side-nav">
        <a class="nav-link" href="/dashboard"><span class="nav-icon">⌂</span>Overview</a>
        <a class="nav-link active" href="/inventory"><span class="nav-icon">▤</span>Inventory</a>
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-note"><span class="online-dot"></span><span><strong>Stockroom status</strong><small>Inventory tracking is active</small></span></div>
        <a class="nav-link logout-link" href="/logout"><span class="nav-icon">↪</span>Sign out</a>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div class="mobile-brand"><span class="brand-mark">P</span><strong>mise.</strong></div>
        <div class="breadcrumbs">Workspace <span>/</span> <strong>Inventory</strong></div>
        <div class="topbar-actions"><span class="today-label">{{today}}</span><span class="avatar">{{userInitial}}</span></div>
      </header>
      <div class="page-wrap">
        <section class="page-heading inventory-heading">
          <div><p class="eyebrow">STOCKROOM</p><h1>Inventory</h1><p class="muted">Keep your ingredients and supplies in check.</p></div>
          <button class="button button-dark" type="button" data-open-dialog="add-item-dialog"><span>＋</span> Add product</button>
        </section>

        {{#if success_msg}}<div class="flash flash-success">{{success_msg}}</div>{{/if}}
        {{#if error_msg}}<div class="flash flash-error">{{error_msg}}</div>{{/if}}

        <section class="inventory-summary">
          <div><span class="summary-label">Products</span><strong>{{totalItems}}</strong></div>
          <span class="summary-divider"></span>
          <div><span class="summary-label">Units in stock</span><strong>{{totalUnits}}</strong></div>
          <span class="summary-divider"></span>
          <div><span class="summary-label">Low stock</span><strong class="{{#if lowStockCount}}text-warning{{/if}}">{{lowStockCount}}</strong></div>
          <span class="summary-spacer"></span>
          <span class="summary-caption">Inventory is updated in real time</span>
        </section>

        <section class="panel inventory-list-panel">
          <form class="filter-bar" action="/inventory" method="GET">
            <label class="search-box"><span>⌕</span><input type="search" name="q" value="{{filters.q}}" placeholder="Search products..." aria-label="Search products"></label>
            <select class="filter-select" name="category" aria-label="Filter by category">
              <option value="">All categories</option>
              {{#each allCategories}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
            </select>
            <select class="filter-select status-select" name="status" aria-label="Filter by stock status">
              <option value="">Any status</option>
              <option value="low" {{#if filters.low}}selected{{/if}}>Low stock</option>
              <option value="in-stock" {{#if filters.inStock}}selected{{/if}}>In stock</option>
            </select>
            <button class="button button-filter" type="submit">Filter</button>
            {{#if filters.active}}<a class="clear-filters" href="/inventory">Clear</a>{{/if}}
          </form>

          <div class="table-wrap inventory-table-wrap">
            <table class="data-table inventory-table">
              <thead><tr><th>PRODUCT</th><th>CATEGORY</th><th>ON HAND</th><th>UNIT COST</th><th>REORDER AT</th><th>STATUS</th><th><span class="sr-only">Actions</span></th></tr></thead>
              <tbody>
                {{#if items.length}}
                  {{#each items}}
                  <tr>
                    <td><div class="product-cell"><span class="product-avatar">{{initial}}</span><span><strong>{{name}}</strong><small>SKU · {{sku}}</small></span></div></td>
                    <td><span class="category-text">{{categoryName}}</span></td>
                    <td><strong>{{quantity}}</strong> <span class="muted">{{unit}}</span></td>
                    <td>{{unitPrice}}</td>
                    <td>{{reorderLevel}} {{unit}}</td>
                    <td><span class="status-badge {{statusClass}}"><i></i>{{status}}</span></td>
                    <td><div class="row-actions"><button type="button" class="icon-button" aria-label="Edit {{name}}" title="Edit product" data-edit-item data-id="{{id}}" data-name="{{name}}" data-quantity="{{quantity}}" data-unit-price="{{rawUnitPrice}}" data-category-id="{{categoryId}}" data-reorder-level="{{reorderLevel}}" data-unit="{{unit}}">✎</button><form action="/inventory/{{id}}/delete" method="POST" data-confirm-delete="{{name}}"><button type="submit" class="icon-button delete-button" aria-label="Delete {{name}}" title="Delete product">×</button></form></div></td>
                  </tr>
                  {{/each}}
                {{else}}
                  <tr><td colspan="7"><div class="table-empty"><span class="empty-icon">⌕</span><strong>{{emptyTitle}}</strong><p>{{emptyMessage}}</p>{{#if filters.active}}<a class="text-link" href="/inventory">Clear filters →</a>{{else}}<button class="text-link text-button" data-open-dialog="add-item-dialog" type="button">Add your first product →</button>{{/if}}</div></td></tr>
                {{/if}}
              </tbody>
            </table>
          </div>
          <div class="table-foot"><span>Showing <strong>{{shownCount}}</strong> of <strong>{{totalItems}}</strong> products</span><span>Stock levels reflect your reorder points</span></div>
        </section>

        <footer class="page-footer"><span>mise. stockroom</span><span>Made for the people behind the plate.</span></footer>
      </div>
    </main>
  </div>

  <dialog class="product-dialog" id="add-item-dialog">
    <form action="/inventory/add" method="POST" class="dialog-form" id="item-form">
      <div class="dialog-heading"><div><p class="eyebrow" id="dialog-eyebrow">NEW STOCK</p><h2 id="dialog-title">Add a product</h2></div><button type="button" class="dialog-close" data-close-dialog aria-label="Close dialog">×</button></div>
      <label class="field-label">Product name<input name="name" type="text" maxlength="120" placeholder="e.g. San Marzano tomatoes" required></label>
      <div class="form-grid">
        <label class="field-label">Category<select name="categoryId" required><option value="">Select a category</option>{{#each allCategories}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
        <label class="field-label">Unit<select name="unit"><option value="units">Units</option><option value="kg">Kilograms</option><option value="g">Grams</option><option value="L">Liters</option><option value="mL">Milliliters</option><option value="packs">Packs</option><option value="cases">Cases</option></select></label>
      </div>
      <div class="form-grid">
        <label class="field-label">Quantity on hand<input name="quantity" type="number" min="0" step="1" placeholder="0" required></label>
        <label class="field-label">Unit cost<input name="unitPrice" type="number" min="0" step="0.01" placeholder="0.00" required></label>
      </div>
      <label class="field-label">Reorder point<input name="reorderLevel" type="number" min="0" step="1" value="5" required><small>You'll see a low-stock alert when stock reaches this amount.</small></label>
      <div class="dialog-actions"><button type="button" class="button button-light" data-close-dialog>Cancel</button><button type="submit" class="button button-dark" id="dialog-submit">Save product</button></div>
    </form>
  </dialog>
  <script src="/app.js" defer></script>
{{> footer }}
